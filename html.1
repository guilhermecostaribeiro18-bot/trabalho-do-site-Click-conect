
<html lang="pt-BR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NekoTech Store - E-Commerce Spec</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@500;600;700;800&display=swap" rel="stylesheet">

  <!-- Tailwind CSS v3 CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            ink: '#0b0a10',
            panel: '#15121f',
            purple: '#6c2bd9',
            jelly: '#b14cff',
            green: '#00c27a',
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
            heading: ['Poppins', 'sans-serif'],
          }
        }
      }
    }
  </script>

  <!-- Custom CSS for theme variables and clean component styles -->
  <style>
    :root {
      --color-ink: #0b0a10;
      --color-panel: #15121f;
      --color-purple: #6c2bd9;
      --color-jelly: #b14cff;
      --color-green: #00c27a;
    }

    * {
      box-sizing: border-box;
      scrollbar-width: thin;
      scrollbar-color: #6c2bd9 #15121f;
    }

    body {
      font-family: 'Inter', sans-serif;
      color: #f7f4fb;
      background: #0b0a10;
      min-width: 320px;
      overflow-x: hidden;
    }

    h1, h2, h3, h4, h5, h6 {
      font-family: 'Poppins', sans-serif;
    }

    ::selection {
      background: #b14cff;
      color: #fff;
    }

    .app-bg {
      min-height: 100vh;
      background: radial-gradient(circle at 50% 20%, rgba(108, 43, 217, 0.12), transparent 35%), #0b0a10;
    }

    .shell {
      width: min(1240px, calc(100% - 48px));
      margin: 0 auto;
    }
    @media (max-width: 700px) {
      .shell {
        width: calc(100% - 28px);
      }
    }

    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: rgba(11, 10, 16, 0.94);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid #292334;
    }

    .search-box {
      box-shadow: 0 0 0 1px transparent;
      transition: all 0.2s ease;
    }
    .search-box:focus-within {
      box-shadow: 0 0 0 2px #b14cff, 0 0 18px rgba(177, 76, 255, 0.25);
    }

    .hero {
      min-height: 415px;
      position: relative;
      overflow: hidden;
      background: #17121f;
      border-radius: 16px;
      border: 1px solid #2a2238;
      isolation: isolate;
    }
    .hero::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(90deg, #15121f 0%, rgba(21, 18, 31, 0.9) 43%, rgba(21, 18, 31, 0.08) 72%),
                  linear-gradient(0deg, rgba(10, 8, 15, 0.4), transparent 50%);
      z-index: -1;
    }

    .edge-ad {
      border-radius: 12px;
      overflow: hidden;
      background: linear-gradient(180deg, #25143b, #130f1b);
      border: 1px solid #342348;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      align-items: center;
      padding: 18px 7px;
      text-align: center;
      position: relative;
    }
    .edge-ad::before {
      content: '';
      width: 90px;
      height: 150px;
      border-radius: 50%;
      background: #6c2bd9;
      filter: blur(45px);
      position: absolute;
      top: -25px;
    }

    .product-card {
      background: #f9f8fb;
      color: #17131d;
      border-radius: 11px;
      overflow: hidden;
      position: relative;
      transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .product-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 14px 35px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(177, 76, 255, 0.3);
    }
    .product-card .add-button {
      opacity: 0;
      transform: translateY(5px);
      transition: all 0.2s ease;
    }
    .product-card:hover .add-button {
      opacity: 1;
      transform: translateY(0);
    }

    @media (max-width: 700px) {
      .product-card .add-button {
        opacity: 1;
        transform: none;
      }
    }

    #toast {
      transform: translateY(100px);
      opacity: 0;
      transition: all 0.3s cubic-bezier(0.68, -0.55, 0.265, 1.55);
    }
    #toast.show {
      transform: translateY(0);
      opacity: 1;
    }
  </style>
</head>
<body class="app-bg text-[#f7f4fb]">

  <!-- Toast Notification -->
  <div id="toast" class="fixed bottom-6 right-6 z-50 bg-[#15121f] border border-[#b14cff] text-white px-5 py-3 rounded-xl shadow-2xl flex items-center gap-3">
    <svg class="w-5 h-5 text-[#00c27a]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
    </svg>
    <span id="toast-message" class="text-xs font-semibold">Item adicionado com sucesso!</span>
  </div>

  <!-- SITE HEADER -->
  <header class="site-header">
    <div class="shell">
      <div class="h-[78px] flex items-center gap-4 md:gap-9">
        <a href="#" class="flex-none flex items-center gap-2.5 text-xl font-extrabold tracking-wider font-heading">
          <svg class="w-10 h-10 text-jelly filter drop-shadow-[0_0_12px_rgba(177,76,255,0.4)]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" />
            <path d="M12 3a9 9 0 00-9 9c0 4.97 4.03 9 9 9s9-4.03 9-9a9 9 0 00-9-9zm-4 5.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm8 0a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm-4 8c-2.33 0-4.31-1.46-5.11-3.5h10.22c-.8 2.04-2.78 3.5-5.11 3.5z"/>
          </svg>
          <span class="hidden sm:inline text-white">NEKO<span class="text-jelly">TECH</span></span>
        </a>

        <div class="search-box h-[46px] flex-1 max-w-[590px] flex bg-white rounded-lg overflow-hidden">
          <input 
            type="text" 
            id="search-input"
            placeholder="Buscar por produtos, marcas e periféricos..." 
            class="flex-1 text-[#26212d] px-4 text-sm bg-transparent outline-none placeholder-[#8d8794]"
          />
          <button id="search-btn" class="w-[52px] grid place-items-center bg-purple text-white hover:bg-jelly transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
          </button>
        </div>

        <div class="flex items-center gap-5 ml-auto">
          <button class="text-[#d4ceda] hover:text-jelly flex items-center gap-2 relative transition">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
            </svg>
            <span class="hidden lg:flex flex-col items-start text-xs font-semibold">
              Favoritos
              <small class="text-[10px] text-[#8e8799] font-normal">Lista de Desejos</small>
            </span>
            <b id="wishlist-badge" class="absolute -top-2 -right-2 w-4 h-4 rounded-full bg-jelly text-white text-[9px] grid place-items-center">0</b>
          </button>

          <button class="text-[#d4ceda] hover:text-jelly flex items-center gap-2 relative transition">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
            <span class="hidden lg:flex flex-col items-start text-xs font-semibold">
              Meu Carrinho
              <small class="text-[10px] text-[#8e8799] font-normal">Ver itens adicionados</small>
            </span>
            <b id="cart-badge" class="absolute -top-2 -right-2 w-[18px] h-[18px] rounded-full bg-jelly text-white text-[10px] grid place-items-center font-bold">0</b>
          </button>
        </div>
      </div>

      <div class="h-[42px] flex items-center gap-7 text-xs text-[#a9a2b2] border-t border-[#292334]/60">
        <div class="flex items-center gap-2 text-[#dcd7e2] whitespace-nowrap">
          <svg class="w-4 h-4 text-jelly" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          Retirada em: <strong class="text-jelly cursor-pointer hover:underline">São Paulo, SP</strong>
        </div>

        <nav class="hidden md:flex gap-6 text-[#a9a2b2]">
          <button class="hover:text-white transition">Hardware</button>
          <button class="hover:text-white transition">Periféricos</button>
          <button class="hover:text-white transition">Monitores</button>
          <button class="hover:text-white transition">Cadeiras Gamer</button>
          <button class="hover:text-white transition">Ofertas do Dia</button>
        </nav>

        <div class="ml-auto hidden sm:flex items-center gap-1.5 text-green whitespace-nowrap font-medium text-xs">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
          </svg>
          Entrega Expressa Garantida
        </div>
      </div>
    </div>
  </header>

  <!-- MAIN CONTENT -->
  <main class="shell pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_110px] gap-3.5 mt-6">
      <div class="hero flex flex-col justify-center">
        <div class="absolute w-[320px] h-[320px] -right-10 top-0 rounded-full bg-purple blur-[120px] opacity-25 -z-10"></div>
        <img 
          id="hero-img"
          src="https://images.unsplash.com/photo-1542751371-adc38448a05e?auto=format&fit=crop&w=1200&q=80" 
          alt="Setup Gamer High-End" 
          class="absolute inset-y-0 right-0 w-full lg:w-[64%] h-full object-cover -z-20 transition-opacity duration-500 opacity-60 lg:opacity-100"
        />

        <div class="w-full lg:w-[58%] p-8 sm:p-14 z-10">
          <span class="font-bold text-xs tracking-[0.18em] text-jelly uppercase block">Lançamento Exclusivo</span>
          <h1 id="hero-title" class="text-3xl sm:text-5xl font-extrabold leading-tight my-3 tracking-tight font-heading">
            Setup Next-Gen com RTX 4090
          </h1>
          <p id="hero-desc" class="max-w-[430px] text-[#bab3c3] text-sm sm:text-base leading-relaxed">
            Performance extrema sem limitações. Garanta já com 15% OFF no PIX e frete grátis para todo o Brasil.
          </p>
          <button class="mt-6 h-[46px] px-6 rounded-lg bg-purple hover:bg-jelly transition inline-flex items-center gap-3 font-bold text-xs sm:text-sm shadow-[0_8px_25px_rgba(108,43,217,0.35)]">
            <span>Ver Configurações</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </button>
        </div>

        <button id="hero-prev" class="absolute left-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-[#0b0a10]/70 border border-[#5a5264] text-white hover:bg-purple flex items-center justify-center transition">
          &#8249;
        </button>
        <button id="hero-next" class="absolute right-3 top-1/2 -translate-y-1/2 w-9 h-9 rounded-full bg-[#0b0a10]/70 border border-[#5a5264] text-white hover:bg-purple flex items-center justify-center transition">
          &#8250;
        </button>

        <div class="absolute bottom-5 left-1/2 -translate-x-1/2 flex gap-2" id="hero-dots">
          <button class="w-7 h-2 rounded-full bg-jelly transition-all" data-index="0"></button>
          <button class="w-2 h-2 rounded-full bg-[#766d7f] transition-all" data-index="1"></button>
          <button class="w-2 h-2 rounded-full bg-[#766d7f] transition-all" data-index="2"></button>
        </div>
      </div>

      <div class="edge-ad hidden lg:flex">
        <span class="writing-vertical text-[9px] font-bold tracking-[0.18em] text-jelly uppercase">PROMOÇÃO</span>
        <b class="font-heading text-xs mt-auto leading-snug">SEMANA GAMER</b>
        <small class="text-green text-[9px] mt-2 font-bold uppercase">Até 40% OFF</small>
      </div>
    </div>

    <section class="pt-14 pb-4">
      <div class="flex justify-between items-end mb-6">
        <div>
          <p class="text-jelly text-[10px] font-bold tracking-[0.12em] uppercase mb-1">Destaques da Semana</p>
          <h2 class="text-2xl font-bold tracking-tight font-heading">Produtos em Alta</h2>
        </div>
        <button class="text-jelly text-xs font-bold flex items-center gap-1.5 hover:underline">
          Ver Todos 
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
      </div>

      <div id="product-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-3.5"></div>
    </section>
  </main>

  <footer class="border-t border-[#2b2532] bg-[#0e0c13] py-9 mt-12">
    <div class="shell flex flex-col md:flex-row items-center gap-6">
      <div class="flex items-center gap-2">
        <svg class="w-6 h-6 text-jelly" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 3a9 9 0 00-9 9c0 4.97 4.03 9 9 9s9-4.03 9-9a9 9 0 00-9-9zm-4 5.5a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm8 0a1.5 1.5 0 110 3 1.5 1.5 0 010-3zm-4 8c-2.33 0-4.31-1.46-5.11-3.5h10.22c-.8 2.04-2.78 3.5-5.11 3.5z"/>
        </svg>
        <span class="font-extrabold font-heading text-sm tracking-wider">NEKOTECH</span>
      </div>
      <p class="text-[#847e8a] text-xs text-center md:text-left">
        &copy; 2026 NekoTech Store Ltd. Todos os direitos reservados.
      </p>
    </div>
  </footer>

  <script>
    const PRODUCTS = [
      { id: 1, name: 'Teclado Mecânico RGB Switch Red', price: 289, cents: '90', oldPrice: 359.90, discount: '-19%', rating: 4.8, reviews: 142, image: 'https://images.unsplash.com/photo-1587829741301-dc798b83add3?auto=format&fit=crop&w=500&q=80' },
      { id: 2, name: 'Mouse Gamer Wireless 16000 DPI', price: 199, cents: '00', oldPrice: 249.00, discount: '-20%', rating: 4.9, reviews: 98, image: 'https://images.unsplash.com/photo-1615663245857-ac93bb7c39e7?auto=format&fit=crop&w=500&q=80' },
      { id: 3, name: 'Headset Surround 7.1 Microfone', price: 349, cents: '50', oldPrice: 420.00, discount: '-16%', rating: 4.7, reviews: 210, image: 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?auto=format&fit=crop&w=500&q=80' },
      { id: 4, name: 'Monitor Gamer 144Hz 1ms IPS', price: 1129, cents: '90', oldPrice: 1399.00, discount: '-19%', rating: 4.9, reviews: 75, image: 'https://images.unsplash.com/photo-1527443224154-c4a3942d3acf?auto=format&fit=crop&w=500&q=80' },
      { id: 5, name: 'Placa de Vídeo RTX 4060 Ti 8GB', price: 2699, cents: '00', oldPrice: 2999.00, discount: '-10%', rating: 5.0, reviews: 310, image: 'https://images.unsplash.com/photo-1591488320449-011701bb6704?auto=format&fit=crop&w=500&q=80' },
      { id: 6, name: 'Cadeira Gamer Ergonômica Reclinável', price: 899, cents: '90', oldPrice: 1099.00, discount: '-18%', rating: 4.6, reviews: 54, image: 'https://images.unsplash.com/photo-1598300042247-d088f8ab3a91?auto=format&fit=crop&w=500&q=80' }
    ];

    let cartCount = 0;
    let wishlistCount = 0;
    const likedProducts = new Set();

    function renderProducts(items) {
      const container = document.getElementById('product-grid');
      container.innerHTML = '';
      if (items.length === 0) {
        container.innerHTML = `<div class="col-span-full text-center py-12 text-gray-400">Nenhum produto encontrado.</div>`;
        return;
      }
      items.forEach(product => {
        const isLiked = likedProducts.has(product.id);
        const card = document.createElement('div');
        card.className = 'product-card';
        card.innerHTML = `
          <div class="h-[178px] relative bg-[#eeecf1] overflow-hidden">
            <img src="${product.image}" alt="${product.name}" class="w-full h-full object-cover mix-blend-multiply" />
            <span class="absolute top-2.5 left-2.5 px-1.5 py-1 rounded bg-green text-[#062919] text-[9px] font-extrabold">${product.discount}</span>
            <button onclick="toggleWishlist(${product.id})" class="absolute top-2.5 right-2.5 w-[31px] h-[31px] rounded-full bg-white/90 grid place-items-center text-[#453e4c] hover:text-jelly transition ${isLiked ? 'text-jelly' : ''}">
              ♥
            </button>
          </div>
          <div class="p-3">
            <div class="flex items-center gap-1 text-[9px] font-bold text-purple">★ ${product.rating} <span class="text-[#96909b] font-normal">(${product.reviews})</span></div>
            <h3 class="h-9 my-1.5 font-sans font-semibold text-xs overflow-hidden leading-snug">${product.name}</h3>
            <div>
              ${product.oldPrice ? `<s class="text-[9px] text-[#8c8791] block">R$ ${product.oldPrice.toFixed(2)}</s>` : ''}
              <div class="font-heading font-bold text-lg leading-none">R$ ${product.price}<small class="text-xs">,${product.cents}</small></div>
            </div>
            <button onclick="addToCart('${product.name}')" class="add-button w-full h-8 bg-purple text-white rounded-md mt-2.5 text-[10px] font-bold hover:bg-jelly transition">Adicionar ao Carrinho</button>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function showToast(msg) {
      const toast = document.getElementById('toast');
      document.getElementById('toast-message').textContent = msg;
      toast.classList.add('show');
      setTimeout(() => toast.classList.remove('show'), 2500);
    }

    function addToCart(name) {
      cartCount++;
      document.getElementById('cart-badge').textContent = cartCount;
      showToast(`"${name}" adicionado ao carrinho!`);
    }

    function toggleWishlist(id) {
      if (likedProducts.has(id)) {
        likedProducts.delete(id);
        wishlistCount--;
      } else {
        likedProducts.add(id);
        wishlistCount++;
      }
      document.getElementById('wishlist-badge').textContent = wishlistCount;
      renderProducts(PRODUCTS);
    }

    document.getElementById('search-input').addEventListener('input', (e) => {
      const term = e.target.value.toLowerCase().trim();
      renderProducts(PRODUCTS.filter(p => p.name.toLowerCase().includes(term)));
    });

    window.addEventListener('DOMContentLoaded', () => renderProducts(PRODUCTS));
  </script>
</body>
</html>